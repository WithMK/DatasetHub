<UserControl x:Class="DatasetHub.Modules.Equipment.EquipmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="설비 관리" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="설정 파일의 설비·PC와 수집 경로를 관리합니다. 삭제해도 기존 수집 데이터는 유지됩니다." Margin="0,6,0,12" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="불러오기" Command="{Binding LoadCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding ConfigPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="불러올 JSON 파일 전체 경로"/></DockPanel><TextBlock Text="{Binding LoadedPath, StringFormat=현재 편집 파일: {0}}" TextWrapping="Wrap" Margin="0,6"/><StackPanel Orientation="Horizontal"><Button Content="설정 저장" Command="{Binding SaveCommand}"/><Button Content="전체 PC 연결 확인" Command="{Binding CheckConnectionsCommand}" Margin="8,0"/><TextBlock Text="{Binding IsDirty, StringFormat=미저장 변경: {0}}" VerticalAlignment="Center"/><TextBlock Text="{Binding IsBusy, StringFormat=   작업 중: {0}}" VerticalAlignment="Center"/></StackPanel></StackPanel>
  <Grid Grid.Row="2" IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="설비 추가" Command="{Binding AddEquipmentCommand}"/><Button Content="삭제" Command="{Binding DeleteEquipmentCommand}" Margin="8,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding Equipments}" SelectedItem="{Binding SelectedEquipment}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding MachineId}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="MachineId"/><TextBox Text="{Binding SelectedEquipment.MachineId, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="수집 활성화" IsChecked="{Binding SelectedEquipment.Enabled}" Margin="0,8"/><TextBlock Text="ID 변경 시 기존 이력·archive는 자동 연결되거나 이동되지 않습니다." Foreground="#975A16" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8"><Button Content="PC 추가" Command="{Binding AddPcCommand}"/><Button Content="PC 삭제" Command="{Binding DeletePcCommand}" Margin="8,0"/><TextBlock Text="PcId로 제어/검사 PC를 구분합니다." VerticalAlignment="Center"/></StackPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedEquipment.Pcs}" SelectedItem="{Binding SelectedPc}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" HeadersVisibility="Column">
     <DataGrid.Columns><DataGridTextColumn Header="PcId" Binding="{Binding PcId, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="로그 원본 SourceRoot" Binding="{Binding SourceRoot, UpdateSourceTrigger=PropertyChanged}" Width="200"/><DataGridTextColumn Header="이미지 원본 ImageSourceRoot" Binding="{Binding ImageSourceRoot, UpdateSourceTrigger=PropertyChanged}" Width="200"/><DataGridTextColumn Header="연결 결과" Binding="{Binding Connection}" IsReadOnly="True" Width="280"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="#EEF3F8" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>