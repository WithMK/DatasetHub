<UserControl x:Class="DatasetHub.Modules.CollectionMonitoring.CollectionMonitoringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="수집 모니터링" FontSize="24"/>
 <DockPanel Grid.Row="1" Margin="0,8"><Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding RefreshCommand}"/><TextBox Text="{Binding ConfigPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="조회할 Collector JSON 경로"/></DockPanel>
 <StackPanel Grid.Row="2"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Text="설비/PC 검색" VerticalAlignment="Center"/><TextBox Width="150" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding StateFilter}" Width="100"/><TextBlock Text="지연 유예(분)" Margin="16,0,8,0" VerticalAlignment="Center"/><TextBox Width="50" Text="{Binding DelayGraceMinutes}"/></StackPanel><TextBlock Text="지연 판정: 이 Desktop의 자동 수집 활성 중에만 적용 · 신규 파일 0개도 정상 완료 가능" Foreground="#666" Margin="0,0,0,8"/></StackPanel>
 <DataGrid Grid.Row="3" ItemsSource="{Binding SourcesView}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
 <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="실패"><Setter Property="Background" Value="#FDE2E2"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="지연"><Setter Property="Background" Value="#FFF1CE"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="수집 중"><Setter Property="Background" Value="#DCEFFD"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="비활성"><Setter Property="Foreground" Value="#888"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
 <DataGrid.Columns><DataGridTextColumn Header="MachineId" Binding="{Binding MachineId}"/><DataGridTextColumn Header="PcId" Binding="{Binding PcId}"/><DataGridTextColumn Header="대상" Binding="{Binding Target}"/><DataGridTextColumn Header="상태" Binding="{Binding State}"/><DataGridTextColumn Header="마지막 시도" Binding="{Binding LastAttempt}"/><DataGridTextColumn Header="마지막 정상 완료" Binding="{Binding LastSuccess}"/><DataGridTextColumn Header="수집 파일" Binding="{Binding CollectedFiles}"/><DataGridTextColumn Header="마지막 오류(과거 포함)" Binding="{Binding LastError}" Width="300"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="4" Margin="0,8"><TextBlock Text="선택 PC 실적: 발견 / 신규·갱신 / 변경 없음 / 실패(파일·경로) / 대기 / 검증 완료 전송 바이트"/><StackPanel Orientation="Horizontal"><TextBlock Text="Log: "/><TextBlock Text="{Binding Selected.Log}"/><TextBlock Text="   Image: " Margin="16,0,0,0"/><TextBlock Text="{Binding Selected.Image}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><DatePicker SelectedDate="{Binding FromDate}" Width="140"/><DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="8,0"/><Button Content="선택 PC 재수집" Command="{Binding RetryPcCommand}"/><Button Content="선택 설비 재수집" Command="{Binding RetryMachineCommand}" Margin="8,0"/><Button Content="재수집 중지" Command="{Binding StopCommand}"/></StackPanel></StackPanel>
 <TabControl Grid.Row="5"><TabItem Header="수집 실행 이력 (최근 200건 · UTC)"><DataGrid ItemsSource="{Binding Runs}" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem><TabItem Header="오류 이력 (최근 200건 · UTC)"><DataGrid ItemsSource="{Binding Errors}" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem></TabControl>
 <TextBlock Grid.Row="6" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid>
</UserControl>