<Window x:Class="DatasetHub.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DatasetHub · 표준 로그 수집" Width="880" Height="620" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="표준 로그 수집" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="설정 파일" VerticalAlignment="Center"/>
   <TextBox Grid.Column="1" Text="{Binding ConfigPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" VerticalContentAlignment="Center"/>
   <Button Grid.Column="2" Content="찾아보기" Click="Browse_Click" Margin="8,0,0,0" Padding="14,4"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
   <TextBlock Text="시작일" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <DatePicker SelectedDate="{Binding FromDate}" Width="150"/>
   <TextBlock Text="종료일" VerticalAlignment="Center" Margin="24,0,10,0"/>
   <DatePicker SelectedDate="{Binding ToDate}" Width="150"/>
   <Button Content="수집 시작" Command="{Binding StartCommand}" Margin="24,0,0,0" Padding="18,5"/>
   <Button Content="중지 요청" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="18,5"/>
  </StackPanel>
  <Border Grid.Row="3" Background="#EEF3F8" Padding="12" Margin="0,0,0,12" CornerRadius="5">
   <StackPanel>
    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <ListBox Grid.Row="4" ItemsSource="{Binding Messages}" FontFamily="Consolas" FontSize="12"/>
  <TextBlock Grid.Row="5" Text="시험용 화면 · 설비의 실제 저장 완료 규칙은 확인 전입니다. 원본에는 쓰거나 삭제하지 않습니다." Margin="0,12,0,0" Foreground="#555" TextWrapping="Wrap"/>
 </Grid>
</Window>
